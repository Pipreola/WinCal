<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景色 -->
    <Color x:Key="BackgroundColor">#FF2D2D2D</Color>
    <Color x:Key="CardBackgroundColor">#FF383838</Color>

    <!-- 强调色（作为「今天」按钮与今日格子的填充底色）。
         比原来的亮蓝 #4CC2FF 调深，以便承载白色文字：
         白字在 #4CC2FF 上对比度仅 2.01（会发灰糊掉），在 #2B7FD4 上为 4.13，
         与浅色主题的 #0078D4 + 白字（4.53）视觉一致。 -->
    <Color x:Key="TodayAccentColor">#FF2B7FD4</Color>

    <!-- 画在面板底色上的强调色（选中态文字与描边）。
         与上面的填充色用途相反：这里需要「亮字对深底」，
         沿用原亮蓝在 #2D2D2D 上对比度 6.87，比填充色 #2B7FD4 的 3.34 清晰得多。 -->
    <Color x:Key="AccentOnSurfaceColor">#FF4CC2FF</Color>

    <!-- 文本色 -->
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FF9D9D9D</Color>
    <Color x:Key="TextDisabledColor">#FF5C5C5C</Color>
    <!-- 强调色之上的文字：与顶部「今天」按钮一致用白色 -->
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!-- 分隔与边框 -->
    <Color x:Key="SeparatorColor">#FF404040</Color>
    <Color x:Key="BorderColor">#FF4A4A4A</Color>

    <!-- 交互状态（Hover 带轻微蓝调，与 CardBackground 区分开） -->
    <Color x:Key="HoverColor">#FF3C434D</Color>
    <Color x:Key="PressedColor">#FF484F5A</Color>
    <Color x:Key="SelectedColor">#FF1A3A4F</Color>

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#66000000</Color>

    <!-- 事件圆点 -->
    <Color x:Key="EventDotColor">#FF4CC2FF</Color>

    <!-- 休 / 班 角标 -->
    <Color x:Key="HolidayBadgeColor">#FF4A90D9</Color>
    <Color x:Key="WorkdayBadgeColor">#FFD98A45</Color>

    <!-- 画刷（从颜色派生） -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="TodayAccentBrush" Color="{StaticResource TodayAccentColor}" />
    <SolidColorBrush x:Key="AccentOnSurfaceBrush" Color="{StaticResource AccentOnSurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="EventDotBrush" Color="{StaticResource EventDotColor}" />
    <SolidColorBrush x:Key="HolidayBadgeBrush" Color="{StaticResource HolidayBadgeColor}" />
    <SolidColorBrush x:Key="WorkdayBadgeBrush" Color="{StaticResource WorkdayBadgeColor}" />

</ResourceDictionary>
