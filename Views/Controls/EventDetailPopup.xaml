<Border x:Class="WinCal.Views.Controls.EventDetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12"
        Width="220"
        Visibility="Collapsed">

    <StackPanel>
        <!-- 事件标题 -->
        <TextBlock x:Name="DetailTitle"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- 时间 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <!-- 矢量图标而非 emoji：emoji 为彩色字形，不跟随 Foreground，深色主题下发黑 -->
            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                  Fill="{DynamicResource TextSecondaryBrush}"
                  Stretch="Uniform" Width="11" Height="11"
                  Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="DetailTime"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 地点 -->
        <StackPanel x:Name="LocationPanel"
                    Orientation="Horizontal" Margin="0,0,0,4"
                    Visibility="Collapsed">
            <Path Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"
                  Fill="{DynamicResource TextSecondaryBrush}"
                  Stretch="Uniform" Width="11" Height="11"
                  Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="DetailLocation"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 日历来源 -->
        <StackPanel x:Name="CalendarPanel"
                    Orientation="Horizontal" Margin="0,0,0,4"
                    Visibility="Collapsed">
            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                  Fill="{DynamicResource TextSecondaryBrush}"
                  Stretch="Uniform" Width="11" Height="11"
                  Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="DetailCalendar"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 分隔线 -->
        <Border Height="1"
                Background="{DynamicResource SeparatorBrush}"
                Margin="0,4,0,6" />

        <!-- 描述 -->
        <TextBlock x:Name="DetailDescription"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   MaxHeight="80"
                   Visibility="Collapsed" />
    </StackPanel>
</Border>
