<UserControl x:Class="WinCal.Views.Controls.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinCal.Views.Controls">

    <UserControl.Resources>
        <!-- 月份切换按钮（‹ ›）：与面板右下角图标按钮一致，
             不画背景色块，仅用透明度反馈 hover。 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent 背景保证整个按钮范围仍可点击 -->
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 「今天」按钮：强调色底 + 白色文字 + 圆角。
             默认 Button 模板不支持 CornerRadius，故自定义模板。
             文字用 TextOnAccentBrush，与日历中今日格子的文字色同源，确保两处配色一致。 -->
        <Style x:Key="TodayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TodayAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- hover 略微提亮，保持与强调色同色系 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 月份导航 -->
            <RowDefinition Height="Auto" />  <!-- 星期头 -->
            <RowDefinition Height="Auto" />  <!-- 日历网格 -->
        </Grid.RowDefinitions>

        <!-- 月份导航栏 -->
        <Grid Grid.Row="0" Height="40" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 上一月按钮 -->
            <Button Grid.Column="0"
                    x:Name="PrevButton"
                    Content="‹"
                    FontSize="18" FontWeight="Bold"
                    Width="28" Height="28"
                    Style="{StaticResource NavButtonStyle}"
                    VerticalAlignment="Center" />

            <!-- 月份标题 + 今天按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="MonthTitle"
                           Text="{Binding MonthDisplay}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="TodayButton"
                        Content="今天"
                        Style="{StaticResource TodayButtonStyle}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- 下一月按钮 -->
            <Button Grid.Column="2"
                    x:Name="NextButton"
                    Content="›"
                    FontSize="18" FontWeight="Bold"
                    Width="28" Height="28"
                    Style="{StaticResource NavButtonStyle}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- 星期头（动态更新，支持周日起始） -->
        <Grid Grid.Row="1" x:Name="WeekHeaderGrid" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="H0" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="H1" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="H2" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" x:Name="H3" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" x:Name="H4" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" x:Name="H5" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="6" x:Name="H6" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </Grid>

        <!-- 日历网格 (6×7) -->
        <!-- ItemContainerStyle 让每个容器拉伸填满 UniformGrid 单元格，
             DayCell 才能铺满整格、不留点击死区 -->
        <ItemsControl Grid.Row="2" x:Name="CalendarGrid" Margin="2,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:DayCell DayData="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
