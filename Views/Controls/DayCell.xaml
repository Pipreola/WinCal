<UserControl x:Class="WinCal.Views.Controls.DayCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Height="48"
             Cursor="Arrow"
             Background="Transparent"
             MouseLeftButtonUp="OnDayClick">

    <!-- RootBorder 铺满整个格子并带背景，保证格子内任意位置都能接收点击，
         不留命中测试死区（Background="Transparent" 参与命中测试，null 不参与）。
         hover / 今日 / 选中三种状态都画在这个方形上。 -->
    <Border x:Name="RootBorder"
            Background="Transparent"
            CornerRadius="4"
            Margin="1">

        <Grid>
            <!-- 日期数字 + 副标题（节日/节气/农历）垂直居中排布 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="DayText"
                           FontSize="14"
                           FontWeight="Normal"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- 副标题：农历节日 / 公历节日 / 节气 / 农历日期（由代码后台填充） -->
                <TextBlock x:Name="LunarText"
                           FontSize="9"
                           Margin="0,1,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- 右上角「休」/「班」角标 -->
            <Border x:Name="HolidayBadge"
                    Width="13" Height="13"
                    CornerRadius="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,1,1,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="HolidayBadgeText"
                           FontSize="8"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- 事件圆点（最多3个，颜色对应事件来源日历） -->
            <StackPanel x:Name="EventDots"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2"
                        Visibility="Collapsed">
                <Ellipse x:Name="Dot1" Width="4" Height="4" Margin="1,0" Visibility="Collapsed"/>
                <Ellipse x:Name="Dot2" Width="4" Height="4" Margin="1,0" Visibility="Collapsed"/>
                <Ellipse x:Name="Dot3" Width="4" Height="4" Margin="1,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
